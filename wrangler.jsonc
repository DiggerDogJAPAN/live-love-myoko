{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "livelove",
    "pages_build_output_dir": "./out",
    "compatibility_date": "2026-10-27",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "send_metrics": false,
    "vars": {
        "FINDER_AUTH_ENABLED": "disabled",
        "FINDER_AUTH_SITE_ORIGIN": "https://love-live-myoko.com",
        "FINDER_CUSTOMER_ACCESS": "disabled",
        "FINDER_GOOGLE_LOGIN_ENABLED": "disabled",
        "FINDER_SUPABASE_PROJECT_REF": "fgdoqsepihlzfqlqymet"
    },
    "env": {
        "production": {
            "vars": {
                "FINDER_AUTH_ENABLED": "enabled",
                "FINDER_AUTH_SITE_ORIGIN": "https://love-live-myoko.com",
                "FINDER_CUSTOMER_ACCESS": "disabled",
                "FINDER_GOOGLE_LOGIN_ENABLED": "disabled",
                "FINDER_SUPABASE_PROJECT_REF": "fgdoqsepihlzfqlqymet"
            }
        }
    }
}
