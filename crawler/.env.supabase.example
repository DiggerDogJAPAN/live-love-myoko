# Copy to .env.supabase.local and keep that private file mode 0600.
# Never paste the URI/password into chat or put it in command-line arguments.
MYOKO_DATABASE_URL=
# Independently copy the expected project reference from the dashboard URL.
MYOKO_SUPABASE_PROJECT_REF=
MYOKO_SUPABASE_PROJECT_NAME="Myoko Property Finder"
# Optional absolute path to the trusted database CA certificate; TLS always verifies the host.
MYOKO_DB_SSLROOTCERT=
